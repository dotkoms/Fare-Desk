# HTTP
PORT=8080

# SQLite ledger: quota per source per day and the fare-history table.
DATABASE_PATH=faredesk.sqlite

# Optional. With a key, /api/search defaults to live Google Flights data via
# SerpAPI. Without one, it answers from the bundled fixture set.
# SERPAPI_KEY=
# Override the endpoint only for a local mock or proxy.
# SERPAPI_BASE_URL=

# Hard daily cap on paid calls. Exhausted calls return 429 with the reset date.
SERPAPI_DAILY_LIMIT=100

# Requests per client per minute. 0 disables the limiter.
RATE_LIMIT_PER_MINUTE=120

# Live OSRM driving legs for airport access; set off for air-gapped runs.
GROUND_ROUTING=on
# OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving
# Live public-transit legs via Transitous (MOTIS); set off to skip.
TRANSIT_ROUTING=on
# TRANSITOUS_BASE_URL=https://api.transitous.org/api/v1/plan

# Quiet hours for alerts, UTC, HH:MM-HH:MM (may wrap midnight).
ALERT_QUIET_HOURS=23:00-07:00

# Comma-separated allowed origins, or * for any.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

RUST_LOG=faredesk_api=info,tower_http=info
