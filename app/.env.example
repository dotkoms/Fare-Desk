# HTTP
PORT=8080

# SQLite ledger: quota per source per day and the fare-history table.
DATABASE_PATH=faredesk.sqlite

# Live fares need nothing here: /api/search uses Kiwi.com's public MCP server,
# which takes no key. KIWI=off turns it off.
# KIWI=on
# Override the endpoint only for a local mock or proxy.
# KIWI_MCP_URL=https://mcp.kiwi.com/
# A politeness cap on Kiwi searches per day (Kiwi meters nothing itself).
KIWI_DAILY_LIMIT=1000

# Skiplagged's public MCP server, also keyless: standard nonstop fares merged
# with Kiwi's, and the cheapest-fare-per-day calendar. SKIPLAGGED=off disables.
# SKIPLAGGED=on
# SKIPLAGGED_MCP_URL=https://mcp.skiplagged.com/mcp
SKIPLAGGED_DAILY_LIMIT=1000

# Optional and not used by default: Google Flights via SerpAPI, only when a
# request asks for source=serpapi (or COLLECTOR_SOURCE=serpapi for the collector).
# SERPAPI_KEY=
# SERPAPI_BASE_URL=
# SERPAPI_DAILY_LIMIT=100

# Requests per client per minute. 0 disables the limiter.
RATE_LIMIT_PER_MINUTE=120

# Live OSRM driving legs for airport access; set off for air-gapped runs.
GROUND_ROUTING=on
# OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving
# Live public-transit legs via Transitous (MOTIS); set off to skip.
TRANSIT_ROUTING=on
# TRANSITOUS_BASE_URL=https://api.transitous.org/api/v1/plan

# Quiet hours for alerts, UTC, HH:MM-HH:MM (may wrap midnight).
ALERT_QUIET_HOURS=23:00-07:00

# Comma-separated allowed origins, or * for any.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

RUST_LOG=faredesk_api=info,tower_http=info
